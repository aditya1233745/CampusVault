rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBranch(branch) {
      return branch in ['CSE', 'ECE', 'MECH', 'CIVIL', 'ISE', 'AIML'];
    }

    function isValidGradYear(year) {
      return year in ['2026', '2027', '2028', '2029'];
    }

    function isValidCategory(category) {
      return category in ['Notes', 'Books', 'Laptops & Tech', 'Calculators & Gear', 'Hostel', 'Uniforms'];
    }

    function isValidPricingMode(mode) {
      return mode in ['Paid', 'Free', 'Borrow'];
    }

    function isValidCondition(condition) {
      return condition in ['New', 'Like New', 'Good', 'Fair'];
    }

    // Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
             data.collegeEmail is string && data.collegeEmail.size() >= 3 && data.collegeEmail.size() <= 120 &&
             isValidBranch(data.branch) &&
             isValidGradYear(data.gradYear) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20)) &&
             data.verified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVaultListing(data) {
      return data.sellerId is string && data.sellerId == request.auth.uid &&
             data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80 &&
             data.batchTag is string && data.batchTag.size() >= 2 && data.batchTag.size() <= 20 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
             isValidCategory(data.category) &&
             data.price is string && data.price.size() >= 1 && data.price.size() <= 24 &&
             data.priceAmount is int && data.priceAmount >= 0 && data.priceAmount <= 500000 &&
             (!('originalPriceAmount' in data) || (data.originalPriceAmount is int && data.originalPriceAmount >= 0 && data.originalPriceAmount <= 500000)) &&
             isValidPricingMode(data.pricingMode) &&
             data.freeItem is bool &&
             data.digitalItem is bool &&
             isValidCondition(data.condition) &&
             data.meetupSpot is string && data.meetupSpot.size() >= 1 && data.meetupSpot.size() <= 80 &&
             data.status in ['active', 'sold'] &&
             data.visibility == 'campus' &&
             (!('borrowDurationDays' in data) || (data.borrowDurationDays is int && data.borrowDurationDays >= 1 && data.borrowDurationDays <= 365)) &&
             (!('borrowWindowLabel' in data) || (data.borrowWindowLabel is string && data.borrowWindowLabel.size() >= 1 && data.borrowWindowLabel.size() <= 32)) &&
             (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 120)) &&
             (!('resourceLink' in data) || (data.resourceLink is string && data.resourceLink.size() <= 500)) &&
             (!('photoUrls' in data) || (
               data.photoUrls is list &&
               data.photoUrls.size() <= 3 &&
               (data.photoUrls.size() < 1 || (data.photoUrls[0] is string && data.photoUrls[0].size() <= 220000)) &&
               (data.photoUrls.size() < 2 || (data.photoUrls[1] is string && data.photoUrls[1].size() <= 220000)) &&
               (data.photoUrls.size() < 3 || (data.photoUrls[2] is string && data.photoUrls[2].size() <= 220000))
             )) &&
             (!('studyTags' in data) || (data.studyTags is list && data.studyTags.size() <= 6)) &&
             (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserListingRef(data, userId, listingId) {
      return data.userId is string && data.userId == userId &&
             data.listingId is string && data.listingId == listingId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             isValidCategory(data.category) &&
             data.price is string && data.price.size() >= 1 && data.price.size() <= 24 &&
             data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80 &&
             data.batchTag is string && data.batchTag.size() >= 2 && data.batchTag.size() <= 20 &&
             data.freeItem is bool &&
             data.digitalItem is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidCampusRequest(data) {
      return isValidId(data.listingId) &&
             data.listingTitle is string && data.listingTitle.size() >= 1 && data.listingTitle.size() <= 120 &&
             isValidCategory(data.listingCategory) &&
             data.listingPrice is string && data.listingPrice.size() >= 1 && data.listingPrice.size() <= 24 &&
             (!('pricingMode' in data) || isValidPricingMode(data.pricingMode)) &&
             (!('askingPriceAmount' in data) || (data.askingPriceAmount is int && data.askingPriceAmount >= 0 && data.askingPriceAmount <= 500000)) &&
             (!('offeredPriceAmount' in data) || (data.offeredPriceAmount is int && data.offeredPriceAmount >= 0 && data.offeredPriceAmount <= 500000)) &&
             (!('counterPriceAmount' in data) || (data.counterPriceAmount is int && data.counterPriceAmount >= 0 && data.counterPriceAmount <= 500000)) &&
             (!('agreedPriceAmount' in data) || (data.agreedPriceAmount is int && data.agreedPriceAmount >= 0 && data.agreedPriceAmount <= 500000)) &&
             (!('negotiationStatus' in data) || data.negotiationStatus in ['none', 'offered', 'countered', 'accepted']) &&
             data.meetupSpot is string && data.meetupSpot.size() >= 1 && data.meetupSpot.size() <= 80 &&
             isValidId(data.buyerId) &&
             data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 80 &&
             data.buyerBatch is string && data.buyerBatch.size() >= 2 && data.buyerBatch.size() <= 20 &&
             (!('buyerPhone' in data) || (data.buyerPhone is string && data.buyerPhone.size() <= 20)) &&
             isValidId(data.sellerId) &&
             data.buyerId != data.sellerId &&
             data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 80 &&
             data.participantIds is list && data.participantIds.size() == 2 &&
             data.buyerId in data.participantIds &&
             data.sellerId in data.participantIds &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
             (!('sellerNote' in data) || (data.sellerNote is string && data.sellerNote.size() <= 500)) &&
             (!('handoverPin' in data) || (data.handoverPin is string && data.handoverPin.matches('^[0-9]{4}$'))) &&
             (!('borrowDurationDays' in data) || (data.borrowDurationDays is int && data.borrowDurationDays >= 1 && data.borrowDurationDays <= 365)) &&
             (!('borrowDueAt' in data) || data.borrowDueAt is timestamp) &&
             (!('borrowReturnStatus' in data) || data.borrowReturnStatus in ['none', 'borrowed', 'returned']) &&
             (!('completedAt' in data) || (data.completedAt is timestamp && data.completedAt <= request.time)) &&
             (!('returnedAt' in data) || (data.returnedAt is timestamp && data.returnedAt <= request.time)) &&
             data.status in ['pending', 'accepted', 'declined', 'completed', 'cancelled'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRequestUpdateFields(data) {
      return data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
             data.listingPrice is string && data.listingPrice.size() >= 1 && data.listingPrice.size() <= 24 &&
             data.status in ['pending', 'accepted', 'declined', 'completed', 'cancelled'] &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('sellerNote' in data) || (data.sellerNote is string && data.sellerNote.size() <= 500)) &&
             (!('buyerPhone' in data) || (data.buyerPhone is string && data.buyerPhone.size() <= 20)) &&
             (!('offeredPriceAmount' in data) || (data.offeredPriceAmount is int && data.offeredPriceAmount >= 0 && data.offeredPriceAmount <= 500000)) &&
             (!('counterPriceAmount' in data) || (data.counterPriceAmount is int && data.counterPriceAmount >= 0 && data.counterPriceAmount <= 500000)) &&
             (!('agreedPriceAmount' in data) || (data.agreedPriceAmount is int && data.agreedPriceAmount >= 0 && data.agreedPriceAmount <= 500000)) &&
             (!('negotiationStatus' in data) || data.negotiationStatus in ['none', 'offered', 'countered', 'accepted']) &&
             (!('handoverPin' in data) || (data.handoverPin is string && data.handoverPin.matches('^[0-9]{4}$'))) &&
             (!('borrowDueAt' in data) || data.borrowDueAt is timestamp) &&
             (!('borrowReturnStatus' in data) || data.borrowReturnStatus in ['none', 'borrowed', 'returned']) &&
             (!('completedAt' in data) || (data.completedAt is timestamp && data.completedAt <= request.time)) &&
             (!('returnedAt' in data) || (data.returnedAt is timestamp && data.returnedAt <= request.time));
    }

    function isValidWantedPost(data) {
      return isValidId(data.requesterId) &&
             data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 80 &&
             data.batchTag is string && data.batchTag.size() >= 2 && data.batchTag.size() <= 20 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 600 &&
             isValidCategory(data.category) &&
             data.maxBudget is string && data.maxBudget.size() >= 1 && data.maxBudget.size() <= 32 &&
             data.meetupSpot is string && data.meetupSpot.size() >= 1 && data.meetupSpot.size() <= 80 &&
             data.status in ['open', 'fulfilled'] &&
             data.visibility == 'campus' &&
             (!('fulfilledListingId' in data) || (data.fulfilledListingId is string && data.fulfilledListingId.size() <= 128)) &&
             (!('fulfilledByName' in data) || (data.fulfilledByName is string && data.fulfilledByName.size() <= 80)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 1. User Profiles (PII protected, strictly owner-only)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'fullName', 'collegeEmail', 'branch', 'gradYear', 'verified', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'fullName', 'collegeEmail', 'branch', 'gradYear', 'phoneNumber', 'verified', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().collegeEmail == existing().collegeEmail &&
                       incoming().verified == existing().verified &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'branch', 'gradYear', 'phoneNumber', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Saved / Bookmarked Listings Subcollection
      match /saved/{listingId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(listingId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(listingId) &&
                         incoming().keys().hasAll(['userId', 'listingId', 'title', 'category', 'price', 'sellerName', 'batchTag', 'freeItem', 'digitalItem', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'listingId', 'title', 'category', 'price', 'sellerName', 'batchTag', 'freeItem', 'digitalItem', 'createdAt']) &&
                         isValidUserListingRef(incoming(), userId, listingId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(listingId);
      }

      // Claimed / Downloaded Listings Subcollection
      match /claims/{listingId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(listingId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(listingId) &&
                         incoming().keys().hasAll(['userId', 'listingId', 'title', 'category', 'price', 'sellerName', 'batchTag', 'freeItem', 'digitalItem', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'listingId', 'title', 'category', 'price', 'sellerName', 'batchTag', 'freeItem', 'digitalItem', 'createdAt']) &&
                         isValidUserListingRef(incoming(), userId, listingId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(listingId);
      }
    }

    // 2. Campus Listings (Public within authenticated campus community, NO PII)
    match /listings/{listingId} {
      allow get: if isSignedIn() &&
                    isValidId(listingId) &&
                    (existing().visibility == 'campus' || existing().sellerId == request.auth.uid);

      allow list: if isSignedIn() && existing().visibility == 'campus';

      allow create: if isSignedIn() &&
                       isValidId(listingId) &&
                       incoming().keys().hasAll([
                         'sellerId', 'sellerName', 'batchTag', 'title', 'description', 'category',
                         'price', 'priceAmount', 'pricingMode', 'freeItem', 'digitalItem',
                         'condition', 'meetupSpot', 'status', 'visibility', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'sellerId', 'sellerName', 'batchTag', 'title', 'description', 'category',
                         'price', 'priceAmount', 'originalPriceAmount', 'pricingMode', 'freeItem', 'digitalItem',
                         'condition', 'meetupSpot', 'status', 'visibility', 'borrowDurationDays', 'borrowWindowLabel',
                         'attachmentName', 'resourceLink', 'photoUrls', 'studyTags', 'aiSummary',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().status == 'active' &&
                       isValidVaultListing(incoming());

      allow update: if isSignedIn() &&
                       isValidId(listingId) &&
                       existing().sellerId == request.auth.uid &&
                       incoming().sellerId == existing().sellerId &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       isValidVaultListing(incoming()) &&
                       (
                         // Action 1: Mark listing as sold (terminal status transition)
                         (existing().status == 'active' &&
                          incoming().status == 'sold' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         // Action 2: Edit active listing details, borrow duration, & price drops
                         (existing().status == 'active' &&
                          incoming().status == 'active' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'description', 'category', 'price', 'priceAmount',
                            'originalPriceAmount', 'pricingMode', 'freeItem', 'digitalItem',
                            'condition', 'meetupSpot', 'borrowDurationDays', 'borrowWindowLabel',
                            'attachmentName', 'resourceLink', 'photoUrls', 'studyTags', 'aiSummary', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(listingId) &&
                       existing().sellerId == request.auth.uid;
    }

    // 3. Campus Requests / Pickup Messages & Live Chat Subcollection
    match /requests/{requestId} {
      allow get: if isSignedIn() &&
                    isValidId(requestId) &&
                    request.auth.uid in existing().participantIds;

      allow list: if isSignedIn() &&
                     request.auth.uid in existing().participantIds;

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().buyerId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'listingId', 'listingTitle', 'listingCategory', 'listingPrice', 'meetupSpot',
                         'buyerId', 'buyerName', 'buyerBatch', 'sellerId', 'sellerName',
                         'participantIds', 'message', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'listingId', 'listingTitle', 'listingCategory', 'listingPrice', 'pricingMode',
                         'askingPriceAmount', 'offeredPriceAmount', 'counterPriceAmount', 'agreedPriceAmount',
                         'negotiationStatus', 'meetupSpot', 'buyerId', 'buyerName', 'buyerBatch', 'buyerPhone',
                         'sellerId', 'sellerName', 'participantIds', 'message', 'sellerNote',
                         'handoverPin', 'borrowDurationDays', 'borrowDueAt', 'borrowReturnStatus',
                         'completedAt', 'returnedAt', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().status == 'pending' &&
                       isValidCampusRequest(incoming()) &&
                       exists(/databases/$(database)/documents/listings/$(incoming().listingId)) &&
                       get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.sellerId == incoming().sellerId &&
                       get(/databases/$(database)/documents/listings/$(incoming().listingId)).data.status == 'active';

      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       request.auth.uid in existing().participantIds &&
                       !(existing().status in ['declined', 'cancelled']) &&
                       isValidRequestUpdateFields(incoming()) &&
                       (
                         // Action 1: Seller accepts, counters, declines, or completes handover (with PIN & borrow due tracking)
                         (existing().sellerId == request.auth.uid &&
                          existing().status != 'completed' &&
                          (
                            (existing().status == 'pending' && incoming().status in ['accepted', 'declined'] &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status', 'sellerNote', 'handoverPin', 'agreedPriceAmount',
                               'negotiationStatus', 'listingPrice', 'updatedAt'
                             ])) ||
                            (existing().status == 'pending' && incoming().status == 'pending' &&
                             incoming().negotiationStatus == 'countered' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'counterPriceAmount', 'negotiationStatus', 'sellerNote', 'updatedAt'
                             ])) ||
                            (existing().status == 'accepted' && incoming().status == 'completed' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status', 'sellerNote', 'completedAt', 'borrowDueAt', 'borrowReturnStatus', 'updatedAt'
                             ]))
                          )) ||
                         // Action 2: Lender marks a completed Borrow handover as returned
                         (existing().sellerId == request.auth.uid &&
                          existing().status == 'completed' &&
                          incoming().status == 'completed' &&
                          ('borrowReturnStatus' in existing()) &&
                          existing().borrowReturnStatus == 'borrowed' &&
                          incoming().borrowReturnStatus == 'returned' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'borrowReturnStatus', 'returnedAt', 'updatedAt'
                          ])) ||
                         // Action 3: Buyer updates note/offer while pending, accepts counter-offer, or cancels
                         (existing().buyerId == request.auth.uid &&
                          existing().status != 'completed' &&
                          (
                            (existing().status == 'pending' && incoming().status == 'pending' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'message', 'offeredPriceAmount', 'negotiationStatus', 'buyerPhone', 'updatedAt'
                             ])) ||
                            (existing().status == 'pending' &&
                             ('negotiationStatus' in existing()) &&
                             existing().negotiationStatus == 'countered' &&
                             incoming().status == 'accepted' &&
                             incoming().negotiationStatus == 'accepted' &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status', 'negotiationStatus', 'agreedPriceAmount', 'listingPrice', 'handoverPin', 'updatedAt'
                             ])) ||
                            (existing().status in ['pending', 'accepted'] && incoming().status == 'cancelled' &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                          ))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(requestId) &&
                       existing().buyerId == request.auth.uid;

      // Live Meetup Chat Thread (strictly buyer & seller)
      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                              isValidId(requestId) &&
                              request.auth.uid in get(/databases/$(database)/documents/requests/$(requestId)).data.participantIds;

        allow create: if isSignedIn() &&
                         isValidId(requestId) &&
                         isValidId(messageId) &&
                         request.auth.uid in get(/databases/$(database)/documents/requests/$(requestId)).data.participantIds &&
                         get(/databases/$(database)/documents/requests/$(requestId)).data.status in ['pending', 'accepted'] &&
                         incoming().keys().hasAll(['requestId', 'senderId', 'senderName', 'senderBatch', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['requestId', 'senderId', 'senderName', 'senderBatch', 'text', 'createdAt']) &&
                         incoming().requestId == requestId &&
                         incoming().senderId == request.auth.uid &&
                         incoming().senderName is string && incoming().senderName.size() >= 1 && incoming().senderName.size() <= 80 &&
                         incoming().senderBatch is string && incoming().senderBatch.size() >= 2 && incoming().senderBatch.size() <= 20 &&
                         incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 500 &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time;

        allow update, delete: if false;
      }
    }

    // 4. Looking For / Wanted Board (Campus community)
    match /wanted/{wantedId} {
      allow get: if isSignedIn() &&
                    isValidId(wantedId) &&
                    (existing().visibility == 'campus' || existing().requesterId == request.auth.uid);

      allow list: if isSignedIn() && existing().visibility == 'campus';

      allow create: if isSignedIn() &&
                       isValidId(wantedId) &&
                       incoming().requesterId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'requesterId', 'requesterName', 'batchTag', 'title', 'description',
                         'category', 'maxBudget', 'meetupSpot', 'status', 'visibility',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'requesterId', 'requesterName', 'batchTag', 'title', 'description',
                         'category', 'maxBudget', 'meetupSpot', 'status', 'visibility',
                         'fulfilledListingId', 'fulfilledByName', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().status == 'open' &&
                       isValidWantedPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(wantedId) &&
                       incoming().requesterId == existing().requesterId &&
                       incoming().visibility == existing().visibility &&
                       incoming().createdAt == existing().createdAt &&
                       isValidWantedPost(incoming()) &&
                       (
                         // Owner updates or marks fulfilled
                         (existing().requesterId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'description', 'category', 'maxBudget', 'meetupSpot',
                            'status', 'fulfilledListingId', 'fulfilledByName', 'updatedAt'
                          ])) ||
                         // Another student fulfills by linking their own active listing
                         (existing().status == 'open' &&
                          incoming().status == 'fulfilled' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'fulfilledListingId', 'fulfilledByName', 'updatedAt'
                          ]) &&
                          ('fulfilledListingId' in incoming()) &&
                          isValidId(incoming().fulfilledListingId) &&
                          exists(/databases/$(database)/documents/listings/$(incoming().fulfilledListingId)) &&
                          get(/databases/$(database)/documents/listings/$(incoming().fulfilledListingId)).data.sellerId == request.auth.uid &&
                          get(/databases/$(database)/documents/listings/$(incoming().fulfilledListingId)).data.status == 'active')
                       );

      allow delete: if isSignedIn() &&
                       isValidId(wantedId) &&
                       existing().requesterId == request.auth.uid;
    }

    // 5. Verified Handover Ratings (One rating per completed request)
    match /ratings/{requestId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       incoming().keys().hasAll([
                         'requestId', 'listingId', 'listingTitle', 'raterId', 'raterName',
                         'sellerId', 'score', 'comment', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'requestId', 'listingId', 'listingTitle', 'raterId', 'raterName',
                         'sellerId', 'score', 'comment', 'createdAt'
                       ]) &&
                       incoming().requestId == requestId &&
                       incoming().raterId == request.auth.uid &&
                       incoming().raterId != incoming().sellerId &&
                       incoming().listingTitle is string && incoming().listingTitle.size() >= 1 && incoming().listingTitle.size() <= 120 &&
                       incoming().raterName is string && incoming().raterName.size() >= 1 && incoming().raterName.size() <= 80 &&
                       incoming().score is int && incoming().score >= 1 && incoming().score <= 5 &&
                       incoming().comment is string && incoming().comment.size() <= 300 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       exists(/databases/$(database)/documents/requests/$(requestId)) &&
                       get(/databases/$(database)/documents/requests/$(requestId)).data.buyerId == request.auth.uid &&
                       get(/databases/$(database)/documents/requests/$(requestId)).data.sellerId == incoming().sellerId &&
                       get(/databases/$(database)/documents/requests/$(requestId)).data.status == 'completed';

      allow update, delete: if false;
    }
  }
}
