Spacer(Modifier.height(16.dp))
                Text("Branch", style = MaterialTheme.typography.labelSmall, color = TextSecondary, modifier = Modifier.align(Alignment.Start))
                Spacer(Modifier.height(8.dp))
                LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    items(branches) { branch ->
                        val active = branch == selectedBranch
                        Box(
                            modifier = Modifier
                                .clip(RoundedCornerShape(50))
                                .background(if (active) EmeraldGreen else SurfaceSubtle)
                                .clickable { selectedBranch = branch }
                                .padding(horizontal = 16.dp, vertical = 9.dp)
                        ) {
                            Text(
                                branch,
                                fontSize = 13.sp,
                                fontWeight = FontWeight.Bold,
                                color = if (active) PureWhite else TextPrimary
                            )
                        }
                    }
                }
                Spacer(Modifier.height(14.dp))
                Text("Graduation Year", style = MaterialTheme.typography.labelSmall, color = TextSecondary, modifier = Modifier.align(Alignment.Start))
                Spacer(Modifier.height(8.dp))
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    years.forEach { year ->
                        val active = year == selectedYear
                        Box(
                            modifier = Modifier
                                .weight(1f)
                                .clip(RoundedCornerShape(50))
                                .background(if (active) EmeraldGreen else SurfaceSubtle)
                                .clickable { selectedYear = year }
                                .padding(vertical = 9.dp),
                            contentAlignment = Alignment.Center
                        ) {
                            Text(
                                year,
                                fontSize = 13.sp,
                                fontWeight = FontWeight.Bold,
                                color = if (active) PureWhite else TextPrimary
                            )
                        }
                    }
                }
                AuthMessageText(localError ?: message)
                Spacer(Modifier.height(22.dp))
                SpringActionButton(
                    text = if (isLoading) "Please wait" else "Create Account",
                    gradient = GreenActionGradient,
                    onClick = {
                        when {
                            isLoading -> Unit
                            fullName.isBlank() -> localError = "Enter your full name"
                            !email.contains("@") -> localError = "Enter a valid email"
                            password.length < 6 -> localError = "Password must be at least 6 characters"
                            else -> {
                                localError = null
                                onSignUp(fullName.trim(), email.trim(), password, selectedBranch, selectedYear)
                            }
                        }
                    },
                    modifier = Modifier
                        .fillMaxWidth()
                        .clip(RoundedCornerShape(50))
                )
            }
        }
    }
}

@Composable
private fun AuthHeaderPattern(modifier: Modifier = Modifier) {
    Canvas(modifier = modifier) {
        val w = size.width
        val h = size.height
        drawCircle(PureWhite.copy(alpha = 0.08f), radius = w * 0.42f, center = Offset(w * 0.92f, h * 0.14f))
        drawCircle(PureWhite.copy(alpha = 0.06f), radius = w * 0.30f, center = Offset(w * 0.62f, h * 0.85f))
        drawCircle(SunsetOrange.copy(alpha = 0.32f), radius = w * 0.06f, center = Offset(w * 0.78f, h * 0.46f))
        drawCircle(SolarAmber.copy(alpha = 0.36f), radius = w * 0.025f, center = Offset(w * 0.24f, h * 0.22f))
    }
}

// ==========================================
// 7. HOME FEED SCREEN (WHITE + GREEN + ORANGE + SKY BLUE + VIOLET)
// ==========================================
@Composable
fun HomeFeedScreen(
    user: UserProfile,
    items: List<VaultItem>,
    savedIds: Set<String>,
    onToggleSave: (String) -> Unit,
    onItemClick: (VaultItem) -> Unit,
    onNavigateToSell: () -> Unit
) {
    var searchQuery by remember { mutableStateOf("") }
    var selectedCategory by remember { mutableStateOf("All") }
    var selectedQuickFilter by remember { mutableStateOf("All") }

    val categories = listOf("All", "Notes", "Books", "Electronics", "Hostel", "Gear")

    val filtered = remember(items, searchQuery, selectedCategory, selectedQuickFilter) {
        items.filter { item ->
            val matchesCat = selectedCategory == "All" || item.category.equals(selectedCategory, ignoreCase = true)
            val matchesQuick = when (selectedQuickFilter) {
                "Free" -> item.isFree
                "Digital" -> item.isDigital
                "Under ₹200" -> {
                    val digits = item.price.filter { it.isDigit() }
                    digits.isNotEmpty() && (digits.toIntOrNull() ?: Int.MAX_VALUE) < 200
                }
                else -> true
            }
            val matchesSearch = searchQuery.isBlank() ||
                item.title.contains(searchQuery, ignoreCase = true) ||
                item.description.contains(searchQuery, ignoreCase = true) ||
                item.category.contains(searchQuery, ignoreCase = true)
            matchesCat && matchesQuick && matchesSearch
        }
    }

    LazyColumn(
        modifier = Modifier
            .fillMaxSize()
            .background(CanvasOffWhite),
        contentPadding = PaddingValues(bottom = 104.dp)
    ) {
        item {
            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .background(PureWhite)
                    .padding(horizontal = 20.dp, vertical = 14.dp)
            ) {
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Box(
                            modifier = Modifier
                                .size(38.dp)
                                .clip(RoundedCornerShape(12.dp))
                                .background(ProfileGradient),
                            contentAlignment = Alignment.Center
                        ) {
                            Text(
                                user.fullName.take(1).uppercase().ifBlank { "C" },
                                color = PureWhite,
                                fontWeight = FontWeight.Black,
                                fontSize = 16.sp
                            )
                        }
                        Spacer(Modifier.width(12.dp))
                        Column {
                            Text("CampusVault", style = MaterialTheme.typography.titleMedium)
                            Text(
                                "${user.fullName.ifBlank { "Member" }} • ${user.batchTag}",
                                fontSize = 12.sp,
                                color = TextSecondary,
                                fontWeight = FontWeight.Medium
                            )
                        }
                    }
                    Box(
                        modifier = Modifier
                            .clip(RoundedCornerShape(50))
                            .background(EmeraldLight)
                            .padding(horizontal = 10.dp, vertical = 5.dp)
                    ) {
                        Text(
                            "VERIFIED",
                            fontSize = 10.sp,
                            fontWeight = FontWeight.ExtraBold,
                            color = EmeraldGreen,
                            letterSpacing = 0.6.sp
                        )
                    }
                }

                Spacer(Modifier.height(14.dp))

                PillInputField(
                    value = searchQuery,
                    onValueChange = { searchQuery = it },
                    placeholder = "Search notes, books, calculators...",
                    leadingIcon = { SearchIcon(color = TextSecondary, size = 18.dp) }
                )

                Spacer(Modifier.height(12.dp))

                LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    items(categories) { cat ->
                        val active = cat == selectedCategory
                        Box(
                            modifier = Modifier
                                .clip(RoundedCornerShape(50))
                                .background(if (active) EmeraldGreen else SurfaceSubtle)
                                .clickable { selectedCategory = cat }
                                .padding(horizontal = 15.dp, vertical = 8.dp)
                        ) {
                            Text(
                                cat,
                                fontSize = 13.sp,
                                fontWeight = FontWeight.Bold,
                                color = if (active) PureWhite else TextPrimary
                            )
                        }
                    }
                }
            }
        }

        item {
            Spacer(Modifier.height(14.dp))
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 20.dp),
                horizontalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                QuickFilterPill("Free", selectedQuickFilter == "Free", SunsetOrange, Modifier.weight(1f)) {
                    selectedQuickFilter = if (selectedQuickFilter == "Free") "All" else "Free"
                }
                QuickFilterPill("Digital", selectedQuickFilter == "Digital", SkyBlue, Modifier.weight(1f)) {
                    selectedQuickFilter = if (selectedQuickFilter == "Digital") "All" else "Digital"
                }
                QuickFilterPill("Under ₹200", selectedQuickFilter == "Under ₹200", VioletPop, Modifier.weight(1f)) {
                    selectedQuickFilter = if (selectedQuickFilter == "Under ₹200") "All" else "Under ₹200"
                }
            }
        }

        item {
            Spacer(Modifier.height(18.dp))
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 20.dp),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text("Campus Listings", style = MaterialTheme.typography.headlineSmall)
                Text(
                    "${filtered.size} available",
                    fontSize = 13.sp,
                    fontWeight = FontWeight.Bold,
                    color = EmeraldGreen
                )
            }
            Spacer(Modifier.height(12.dp))
        }

        if (filtered.isEmpty()) {
            item {
                EmptyFeedCard(
                    onPostClick = onNavigateToSell,
                    modifier = Modifier.padding(horizontal = 20.dp)
                )
            }
        } else {
            item {
                LazyVerticalStaggeredGrid(
                    columns = StaggeredGridCells.Fixed(2),
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(((filtered.size / 2 + 1) * 235).dp)
                        .padding(horizontal = 16.dp),
                    horizontalArrangement = Arrangement.spacedBy(12.dp),
                    verticalArrangement = Arrangement.spacedBy(12.dp),
                    userScrollEnabled = false
                ) {
                    items(filtered, key = { it.id }) { item ->
                        VaultGridCard(
                            item = item,
                            isSaved = item.id in savedIds,
                            onToggleSave = { onToggleSave(item.id) },
                            onClick = { onItemClick(item) }
                        )
                    }
                }
            }
        }
    }
}

@Composable
private fun QuickFilterPill(
    label: String,
    active: Boolean,
    accent: Color,
    modifier: Modifier = Modifier,
    onClick: () -> Unit
) {
    val bg by animateColorAsState(if (active) accent else PureWhite, tween(180), label = "pillBg")
    val fg by animateColorAsState(if (active) PureWhite else TextPrimary, tween(180), label = "pillFg")
    Box(
        modifier = modifier
            .clip(RoundedCornerShape(50))
            .background(bg)
            .border(1.dp, if (active) accent else BorderLight, RoundedCornerShape(50))
            .clickable(onClick = onClick)
            .padding(vertical = 9.dp),
        contentAlignment = Alignment.Center
    ) {
        Text(
            label,
            fontSize = 12.sp,
            fontWeight = FontWeight.Bold,
            color = fg,
            maxLines = 1,
            overflow = TextOverflow.Ellipsis
        )
    }
}

@Composable
private fun VaultGridCard(
    item: VaultItem,
    isSaved: Boolean,
    onToggleSave: () -> Unit,
    onClick: () -> Unit
) {
    val accent = categoryAccent(item.category)
    val cardHeight = if (item.isDigital || item.isFree) 196.dp else 224.dp

    Surface(
        modifier = Modifier
            .fillMaxWidth()
            .height(cardHeight)
            .clickable(onClick = onClick),
        shape = RoundedCornerShape(22.dp),
        color = PureWhite,
        shadowElevation = 2.dp
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(14.dp),
            verticalArrangement = Arrangement.SpaceBetween
        ) {
            Column {
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(
                        modifier = Modifier
                            .size(42.dp)
                            .clip(RoundedCornerShape(14.dp))
                            .background(accent.copy(alpha = 0.14f)),
                        contentAlignment = Alignment.Center
                    ) {
                        CategoryArtIcon(category = item.category, tint = accent, size = 22.dp)
                    }
                    Box(
                        modifier = Modifier
                            .size(34.dp)
                            .clip(CircleShape)
                            .background(if (isSaved) SunsetOrange.copy(alpha = 0.14f) else SurfaceSubtle)
                            .clickable(onClick = onToggleSave),
                        contentAlignment = Alignment.Center
                    ) {
                        BookmarkIcon(
                            filled = isSaved,
                            color = if (isSaved) SunsetOrange else TextSecondary,
                            size = 16.dp
                        )
                    }
                }

                Spacer(Modifier.height(12.dp))

                Text(
                    item.title,
                    style = MaterialTheme.typography.titleMedium,
                    maxLines = 2,
                    overflow = TextOverflow.Ellipsis
                )

                Spacer(Modifier.height(4.dp))

                Text(
                    "${item.sellerName} • ${item.batchTag}",
                    fontSize = 11.sp,
                    color = TextSecondary,
                    maxLines = 1,
                    overflow = TextOverflow.Ellipsis
                )
            }

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    if (item.isFree) "FREE" else item.price,
                    fontSize = 15.sp,
                    fontWeight = FontWeight.Black,
                    color = if (item.isFree) EmeraldGreen else TextPrimary
                )
                Box(
                    modifier = Modifier
                        .clip(RoundedCornerShape(50))
                        .background(accent.copy(alpha = 0.14f))
                        .padding(horizontal = 8.dp, vertical = 4.dp)
                ) {
                    Text(
                        item.category,
                        fontSize = 10.sp,
                        fontWeight = FontWeight.ExtraBold,
                        color = accent
                    )
                }
            }
        }
    }
}

