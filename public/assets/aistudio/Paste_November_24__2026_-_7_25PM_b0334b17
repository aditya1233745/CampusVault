// 8. POST / SELL UPLOAD SCREEN (GREEN + ORANGE + SKY BLUE)
// ==========================================
@Composable
fun SellUploadScreen(
    user: UserProfile,
    isPosting: Boolean,
    errorMessage: String?,
    onPost: (VaultItem, Uri?) -> Unit
) {
    val context = LocalContext.current
    var title by remember { mutableStateOf("") }
    var description by remember { mutableStateOf("") }
    var category by remember { mutableStateOf("Notes") }
    var pricingMode by remember { mutableStateOf("Paid") }
    var price by remember { mutableStateOf("") }
    var condition by remember { mutableStateOf("Good") }
    var meetupSpot by remember { mutableStateOf("Central Library") }
    var selectedFileUri by remember { mutableStateOf<Uri?>(null) }
    var localError by remember { mutableStateOf<String?>(null) }

    val categories = listOf("Notes", "Books", "Electronics", "Hostel", "Gear")
    val pricingModes = listOf("Paid", "Free", "Borrow")
    val conditions = listOf("New", "Like New", "Good", "Fair")
    val meetups = listOf("Central Library", "Main Canteen", "Student Center", "Hostel Block A")

    val filePicker = rememberLauncherForActivityResult(ActivityResultContracts.GetContent()) { uri ->
        selectedFileUri = uri
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(CanvasOffWhite)
            .verticalScroll(rememberScrollState())
            .padding(bottom = 108.dp)
    ) {
        Box(
            modifier = Modifier
                .fillMaxWidth()
                .background(PureWhite)
                .padding(horizontal = 20.dp, vertical = 18.dp)
        ) {
            Column {
                Text("List on CampusVault", style = MaterialTheme.typography.headlineSmall)
                Spacer(Modifier.height(2.dp))
                Text(
                    "Posting as ${user.fullName.ifBlank { "Member" }} • ${user.batchTag}",
                    fontSize = 13.sp,
                    color = TextSecondary
                )
            }
        }

        Spacer(Modifier.height(14.dp))

        Surface(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 16.dp),
            shape = RoundedCornerShape(24.dp),
            color = PureWhite,
            shadowElevation = 2.dp
        ) {
            Column(modifier = Modifier.padding(18.dp)) {
                Text("Category", style = MaterialTheme.typography.labelSmall, color = TextSecondary)
                Spacer(Modifier.height(8.dp))
                LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    items(categories) { cat ->
                        val active = cat == category
                        val accent = categoryAccent(cat)
                        Box(
                            modifier = Modifier
                                .clip(RoundedCornerShape(50))
                                .background(if (active) accent else SurfaceSubtle)
                                .clickable { category = cat }
                                .padding(horizontal = 14.dp, vertical = 8.dp)
                        ) {
                            Text(
                                cat,
                                fontSize = 12.sp,
                                fontWeight = FontWeight.Bold,
                                color = if (active) PureWhite else TextPrimary
                            )
                        }
                    }
                }

                Spacer(Modifier.height(16.dp))

                PillInputField(
                    value = title,
                    onValueChange = { title = it },
                    placeholder = "Title (e.g., Operating Systems Notes)"
                )

                Spacer(Modifier.height(12.dp))

                PillInputField(
                    value = description,
                    onValueChange = { description = it },
                    placeholder = "Short details, edition, or pickup notes"
                )

                Spacer(Modifier.height(16.dp))

                Text("Listing Type", style = MaterialTheme.typography.labelSmall, color = TextSecondary)
                Spacer(Modifier.height(8.dp))
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    pricingModes.forEach { mode ->
                        val active = mode == pricingMode
                        val modeColor = when (mode) {
                            "Free" -> EmeraldGreen
                            "Borrow" -> SkyBlue
                            else -> SunsetOrange
                        }
                        Box(
                            modifier = Modifier
                                .weight(1f)
                                .clip(RoundedCornerShape(50))
                                .background(if (active) modeColor else SurfaceSubtle)
                                .clickable {
                                    pricingMode = mode
                                    if (mode == "Free" || mode == "Borrow") price = ""
                                }
                                .padding(vertical = 10.dp),
                            contentAlignment = Alignment.Center
                        ) {
                            Text(
                                mode,
                                fontSize = 13.sp,
                                fontWeight = FontWeight.Bold,
                                color = if (active) PureWhite else TextPrimary
                            )
                        }
                    }
                }

                if (pricingMode == "Paid") {
                    Spacer(Modifier.height(12.dp))
                    PillInputField(
                        value = price,
                        onValueChange = { price = it.filter { ch -> ch.isDigit() } },
                        placeholder = "Price in ₹ (e.g., 150)",
                        keyboardType = KeyboardType.Number
                    )
                }

                Spacer(Modifier.height(16.dp))

                Text("Condition", style = MaterialTheme.typography.labelSmall, color = TextSecondary)
                Spacer(Modifier.height(8.dp))
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    conditions.forEach { cond ->
                        val active = cond == condition
                        Box(
                            modifier = Modifier
                                .weight(1f)
                                .clip(RoundedCornerShape(50))
                                .background(if (active) VioletPop else SurfaceSubtle)
                                .clickable { condition = cond }
                                .padding(vertical = 9.dp),
                            contentAlignment = Alignment.Center
                        ) {
                            Text(
                                cond,
                                fontSize = 12.sp,
                                fontWeight = FontWeight.Bold,
                                color = if (active) PureWhite else TextPrimary,
                                maxLines = 1
                            )
                        }
                    }
                }

                Spacer(Modifier.height(16.dp))

                Text("Campus Meetup Spot", style = MaterialTheme.typography.labelSmall, color = TextSecondary)
                Spacer(Modifier.height(8.dp))
                LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                    items(meetups) { spot ->
                        val active = spot == meetupSpot
                        Box(
                            modifier = Modifier
                                .clip(RoundedCornerShape(50))
                                .background(if (active) EmeraldGreen else SurfaceSubtle)
                                .clickable { meetupSpot = spot }
                                .padding(horizontal = 14.dp, vertical = 8.dp)
                        ) {
                            Text(
                                spot,
                                fontSize = 12.sp,
                                fontWeight = FontWeight.Bold,
                                color = if (active) PureWhite else TextPrimary
                            )
                        }
                    }
                }

                Spacer(Modifier.height(16.dp))

                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .clip(RoundedCornerShape(18.dp))
                        .background(SkyLight)
                        .clickable { filePicker.launch("*/*") }
                        .padding(horizontal = 14.dp, vertical = 12.dp),
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.SpaceBetween
                ) {
                    Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.weight(1f)) {
                        UploadIcon(color = SkyBlue, size = 18.dp)
                        Spacer(Modifier.width(10.dp))
                        Text(
                            selectedFileUri?.let { displayName(context, it) } ?: "Attach PDF or photo (optional)",
                            fontSize = 13.sp,
                            fontWeight = FontWeight.SemiBold,
                            color = SkyBlue,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis
                        )
                    }
                    Text(
                        if (selectedFileUri == null) "Browse" else "Change",
                        fontSize = 12.sp,
                        fontWeight = FontWeight.ExtraBold,
                        color = SkyBlue
                    )
                }

                val feedback = localError ?: errorMessage
                if (!feedback.isNullOrBlank()) {
                    Spacer(Modifier.height(12.dp))
                    Text(
                        feedback,
                        fontSize = 13.sp,
                        fontWeight = FontWeight.SemiBold,
                        color = AlertCrimson
                    )
                }

                Spacer(Modifier.height(20.dp))

                SpringActionButton(
                    text = if (isPosting) "Publishing" else "Publish Listing",
                    gradient = OrangeAccentGradient,
                    onClick = {
                        when {
                            isPosting -> Unit
                            title.isBlank() -> localError = "Please enter a title"
                            pricingMode == "Paid" && price.isBlank() -> localError = "Enter a price or choose Free / Borrow"
                            else -> {
                                localError = null
                                val isFree = pricingMode == "Free"
                                val formattedPrice = when (pricingMode) {
                                    "Free" -> "Free"
                                    "Borrow" -> "Borrow"
                                    else -> "₹$price"
                                }
                                onPost(
                                    VaultItem(
                                        id = "item_${System.currentTimeMillis()}",
                                        title = title.trim(),
                                        description = description.trim().ifBlank { "Available on campus at $meetupSpot." },
                                        category = category,
                                        price = formattedPrice,
                                        pricingMode = pricingMode,
                                        isFree = isFree,
                                        isDigital = category == "Notes" || selectedFileUri != null,
                                        condition = condition,
                                        sellerName = user.fullName.ifBlank { "Member" },
                                        batchTag = user.batchTag,
                                        meetupSpot = meetupSpot
                                    ),
                                    selectedFileUri
                                )
                            }
                        }
                    },
                    modifier = Modifier
                        .fillMaxWidth()
                        .clip(RoundedCornerShape(50))
                )
            }
        }
    }
}

