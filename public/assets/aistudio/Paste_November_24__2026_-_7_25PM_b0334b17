@Composable
fun SpringActionButton(
    text: String,
    gradient: Brush,
    onClick: () -> Unit,
    modifier: Modifier = Modifier
) {
    val haptics = LocalHapticFeedback.current
    val interaction = remember { MutableInteractionSource() }
    val pressed by interaction.collectIsPressedAsState()
    val scale by animateFloatAsState(
        targetValue = if (pressed) 0.96f else 1f,
        animationSpec = spring(dampingRatio = 0.45f, stiffness = 450f),
        label = "btnScale"
    )

    Box(
        modifier = modifier
            .scale(scale)
            .height(54.dp)
            .background(gradient)
            .clickable(interactionSource = interaction, indication = null) {
                haptics.performHapticFeedback(HapticFeedbackType.TextHandleMove)
                onClick()
            },
        contentAlignment = Alignment.Center
    ) {
        Text(
            text = text,
            fontFamily = DisplayFamily,
            fontSize = 15.sp,
            fontWeight = FontWeight.ExtraBold,
            color = PureWhite,
            maxLines = 1,
            overflow = TextOverflow.Ellipsis
        )
    }
}

@Composable
fun AnimatedFloatingBottomBar(
    selectedTab: Int,
    onTabSelected: (Int) -> Unit,
    modifier: Modifier = Modifier
) {
    Surface(
        modifier = modifier
            .fillMaxWidth()
            .shadow(14.dp, RoundedCornerShape(50), ambientColor = Color.Black.copy(alpha = 0.12f)),
        shape = RoundedCornerShape(50),
        color = PureWhite,
        border = BorderStroke(1.dp, BorderLight)
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 8.dp, vertical = 7.dp),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            FloatingNavPill(
                label = "Home",
                selected = selectedTab == 0,
                activeColor = EmeraldGreen,
                onClick = { onTabSelected(0) },
                icon = { color -> HomeIcon(color = color, size = 18.dp) }
            )
            FloatingNavPill(
                label = "Post",
                selected = selectedTab == 1,
                activeColor = SunsetOrange,
                onClick = { onTabSelected(1) },
                icon = { color -> PlusIcon(color = color, size = 18.dp) }
            )
            FloatingNavPill(
                label = "Profile",
                selected = selectedTab == 2,
                activeColor = VioletPop,
                onClick = { onTabSelected(2) },
                icon = { color -> ProfileIcon(color = color, size = 18.dp) }
            )
        }
    }
}

@Composable
private fun FloatingNavPill(
    label: String,
    selected: Boolean,
    activeColor: Color,
    onClick: () -> Unit,
    icon: @Composable (Color) -> Unit
) {
    val bg by animateColorAsState(
        if (selected) activeColor.copy(alpha = 0.14f) else Color.Transparent,
        tween(200),
        label = "navBg"
    )
    val contentColor by animateColorAsState(
        if (selected) activeColor else TextSecondary,
        tween(200),
        label = "navFg"
    )
    Row(
        modifier = Modifier
            .clip(RoundedCornerShape(50))
            .background(bg)
            .animateContentSize(spring(dampingRatio = 0.7f, stiffness = 380f))
            .clickable(onClick = onClick)
            .padding(horizontal = if (selected) 18.dp else 16.dp, vertical = 10.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.Center
    ) {
        icon(contentColor)
        AnimatedVisibility(visible = selected) {
            Row {
                Spacer(Modifier.width(7.dp))
                Text(
                    label,
                    fontSize = 13.sp,
                    fontWeight = FontWeight.ExtraBold,
                    color = contentColor,
                    maxLines = 1,
                    softWrap = false
                )
            }
        }
    }
}

private fun categoryAccent(category: String): Color = when (category) {
    "Notes" -> SkyBlue
    "Books" -> EmeraldGreen
    "Electronics" -> VioletPop
    "Hostel" -> SunsetOrange
    else -> EmeraldGreen
}

@Composable
private fun CategoryArtIcon(category: String, tint: Color, size: Dp) {
    when (category) {
        "Notes" -> BookArt(tint, size)
        "Books" -> BookArt(tint, size)
        "Electronics" -> BoltArt(tint, size)
        "Hostel" -> HomeIcon(tint, size)
        else -> BoxArt(tint, size)
    }
}

@Composable
private fun BookArt(color: Color, size: Dp) {
    Canvas(Modifier.size(size)) {
        val w = this.size.width
        val h = this.size.height
        val s = Stroke(width = w * 0.1f, cap = StrokeCap.Round, join = StrokeJoin.Round)
        drawRoundRect(color, Offset(w * 0.18f, h * 0.14f), Size(w * 0.64f, h * 0.72f), CornerRadius(w * 0.08f), style = s)
        drawLine(color, Offset(w * 0.34f, h * 0.14f), Offset(w * 0.34f, h * 0.86f), strokeWidth = w * 0.09f)
    }
}

@Composable
private fun BoltArt(color: Color, size: Dp) {
    Canvas(Modifier.size(size)) {
        val w = this.size.width
        val h = this.size.height
        val path = Path().apply {
            moveTo(w * 0.56f, h * 0.12f)
            lineTo(w * 0.24f, h * 0.56f)
            lineTo(w * 0.50f, h * 0.56f)
            lineTo(w * 0.44f, h * 0.88f)
            lineTo(w * 0.76f, h * 0.44f)
            lineTo(w * 0.50f, h * 0.44f)
            close()
        }
        drawPath(path, color)
    }
}

@Composable
private fun BoxArt(color: Color, size: Dp) {
    Canvas(Modifier.size(size)) {
        val w = this.size.width
        val h = this.size.height
        val s = Stroke(width = w * 0.1f, cap = StrokeCap.Round, join = StrokeJoin.Round)
        drawRoundRect(color, Offset(w * 0.16f, h * 0.22f), Size(w * 0.68f, h * 0.58f), CornerRadius(w * 0.1f), style = s)
        drawLine(color, Offset(w * 0.16f, h * 0.42f), Offset(w * 0.84f, h * 0.42f), strokeWidth = w * 0.09f)
    }
}

