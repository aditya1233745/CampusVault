@Composable
fun ProfileScreen(
    user: UserProfile,
    listings: List<VaultItem>,
    savedIds: Set<String>,
    downloadedIds: Set<String>,
    onMarkSold: (String) -> Unit,
    onDeleteListing: (String) -> Unit,
    onSignOut: () -> Unit
) {
    val myListings = remember(listings, user.id) {
        listings.filter { it.sellerId == user.id || it.sellerId.isBlank() }
    }

    LazyColumn(
        modifier = Modifier
            .fillMaxSize()
            .background(CanvasOffWhite),
        contentPadding = PaddingValues(bottom = 108.dp)
    ) {
        item {
            Surface(
                modifier = Modifier.fillMaxWidth(),
                color = PureWhite,
                shadowElevation = 2.dp
            ) {
                Column(modifier = Modifier.padding(20.dp)) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Box(
                            modifier = Modifier
                                .size(56.dp)
                                .clip(RoundedCornerShape(18.dp))
                                .background(ProfileGradient),
                            contentAlignment = Alignment.Center
                        ) {
                            Text(
                                user.fullName.take(1).uppercase().ifBlank { "C" },
                                fontSize = 22.sp,
                                fontWeight = FontWeight.Black,
                                color = PureWhite
                            )
                        }
                        Spacer(Modifier.width(14.dp))
                        Column(modifier = Modifier.weight(1f)) {
                            Text(
                                user.fullName.ifBlank { "Campus Member" },
                                style = MaterialTheme.typography.headlineSmall
                            )
                            Text(
                                "${user.batchTag} • ${user.collegeEmail}",
                                fontSize = 12.sp,
                                color = TextSecondary,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis
                            )
                        }
                    }

                    Spacer(Modifier.height(18.dp))

                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.spacedBy(10.dp)
                    ) {
                        ProfileMetricBox("Listed", myListings.size.toString(), EmeraldGreen, Modifier.weight(1f))
                        ProfileMetricBox("Saved", savedIds.size.toString(), SunsetOrange, Modifier.weight(1f))
                        ProfileMetricBox("Claimed", downloadedIds.size.toString(), SkyBlue, Modifier.weight(1f))
                    }
                }
            }
        }

        item {
            Spacer(Modifier.height(18.dp))
            Text(
                "Your Listings",
                style = MaterialTheme.typography.titleMedium,
                modifier = Modifier.padding(horizontal = 20.dp)
            )
            Spacer(Modifier.height(10.dp))
        }

        if (myListings.isEmpty()) {
            item {
                Surface(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(horizontal = 16.dp),
                    shape = RoundedCornerShape(20.dp),
                    color = PureWhite
                ) {
                    Text(
                        "You haven't posted any items yet.",
                        fontSize = 13.sp,
                        color = TextSecondary,
                        modifier = Modifier.padding(20.dp)
                    )
                }
            }
        } else {
            items(myListings, key = { it.id }) { item ->
                Surface(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(horizontal = 16.dp, vertical = 5.dp),
                    shape = RoundedCornerShape(20.dp),
                    color = PureWhite,
                    shadowElevation = 1.dp
                ) {
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(16.dp),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Column(modifier = Modifier.weight(1f)) {
                            Text(item.title, style = MaterialTheme.typography.titleMedium, maxLines = 1, overflow = TextOverflow.Ellipsis)
                            Text(
                                "${if (item.isSold) "Sold" else item.price} • ${item.category}",
                                fontSize = 12.sp,
                                color = if (item.isSold) TextSecondary else EmeraldGreen,
                                fontWeight = FontWeight.Bold
                            )
                        }
                        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                            if (!item.isSold) {
                                Box(
                                    modifier = Modifier
                                        .clip(RoundedCornerShape(50))
                                        .background(EmeraldLight)
                                        .clickable { onMarkSold(item.id) }
                                        .padding(horizontal = 12.dp, vertical = 6.dp)
                                ) {
                                    Text("Mark Sold", fontSize = 11.sp, fontWeight = FontWeight.Bold, color = EmeraldGreen)
                                }
                            }
                            Box(
                                modifier = Modifier
                                    .clip(RoundedCornerShape(50))
                                    .background(AlertCrimson.copy(alpha = 0.1f))
                                    .clickable { onDeleteListing(item.id) }
                                    .padding(horizontal = 12.dp, vertical = 6.dp)
                            ) {
                                Text("Remove", fontSize = 11.sp, fontWeight = FontWeight.Bold, color = AlertCrimson)
                            }
                        }
                    }
                }
            }
        }

        item {
            Spacer(Modifier.height(22.dp))
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 20.dp)
                    .clip(RoundedCornerShape(50))
                    .background(PureWhite)
                    .border(1.dp, BorderLight, RoundedCornerShape(50))
                    .clickable(onClick = onSignOut)
                    .padding(vertical = 14.dp),
                contentAlignment = Alignment.Center
            ) {
                Text("Sign Out", fontSize = 14.sp, fontWeight = FontWeight.Bold, color = AlertCrimson)
            }
        }
    }
}

@Composable
