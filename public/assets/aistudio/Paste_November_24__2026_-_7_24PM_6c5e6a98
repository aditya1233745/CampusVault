@Composable
fun CampusVaultApp(startAuthenticated: Boolean = false) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()
    var currentUser by remember {
        mutableStateOf(
            if (startAuthenticated) UserProfile("Member", "student@college.edu", "CSE", "2026", id = "local-user")
            else null
        )
    }
    var selectedTab by remember { mutableIntStateOf(0) }
    var selectedItem by remember { mutableStateOf<VaultItem?>(null) }
    var listings by remember { mutableStateOf<List<VaultItem>>(emptyList()) }
    var savedIds by remember { mutableStateOf<Set<String>>(emptySet()) }
    var downloadedIds by remember { mutableStateOf<Set<String>>(emptySet()) }
    var authLoading by remember { mutableStateOf(false) }
    var authMessage by remember { mutableStateOf<String?>(null) }
    var isPosting by remember { mutableStateOf(false) }
    var postError by remember { mutableStateOf<String?>(null) }

    fun toggleSave(id: String) {
        savedIds = if (id !in savedIds) savedIds + id else savedIds - id
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(CanvasOffWhite)
            .windowInsetsPadding(WindowInsets.systemBars)
    ) {
        when {
            currentUser == null -> {
                OnboardingAuthScreen(
                    isLoading = authLoading,
                    message = authMessage,
                    onModeChange = { authMessage = null },
                    onLogin = { email, _ ->
                        scope.launch {
                            authLoading = true
                            authMessage = null
                            delay(250)
                            val namePart = email.substringBefore("@").replaceFirstChar { it.uppercase() }
                            currentUser = UserProfile(
                                fullName = namePart.ifBlank { "Student" },
                                collegeEmail = email,
                                branch = "CSE",
                                gradYear = "2026",
                                id = "local-user"
                            )
                            authLoading = false
                        }
                    },
                    onSignUp = { name, email, _, branch, year ->
                        scope.launch {
                            authLoading = true
                            authMessage = null
                            delay(250)
                            currentUser = UserProfile(
                                fullName = name,
                                collegeEmail = email,
                                branch = branch,
                                gradYear = year,
                                id = "local-user"
                            )
                            authLoading = false
                        }
                    }
                )
            }
            selectedItem != null -> {
                val item = selectedItem!!
                ProductDetailScreen(
                    item = item,
                    isSaved = item.id in savedIds,
                    isDownloaded = item.id in downloadedIds,
                    onBack = { selectedItem = null },
                    onToggleSave = { toggleSave(item.id) },
                    onPrimaryAction = {
                        if (item.fileUrl.isNotBlank()) {
                            context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(item.fileUrl)))
                        }
                        if (item.id !in downloadedIds) {
                            downloadedIds = downloadedIds + item.id
                        }
                    }
                )
            }
            else -> {
                AnimatedContent(
                    targetState = selectedTab,
                    transitionSpec = {
                        (fadeIn(tween(220)) + slideInVertically(tween(220)) { it / 28 })
                            .togetherWith(fadeOut(tween(150)))
                    },
                    label = "tabTransition"
                ) { tab ->
                    when (tab) {
                        0 -> HomeFeedScreen(
                            user = currentUser!!,
                            items = listings.filter { !it.isSold },
                            savedIds = savedIds,
                            onToggleSave = { id -> toggleSave(id) },
                            onItemClick = { selectedItem = it },
                            onNavigateToSell = { selectedTab = 1 }
                        )
                        1 -> SellUploadScreen(
                            user = currentUser!!,
                            isPosting = isPosting,
                            errorMessage = postError,
                            onPost = { draft, fileUri ->
                                if (!isPosting) {
                                    isPosting = true
                                    postError = null
                                    val newItem = draft.copy(
                                        sellerId = currentUser!!.id,
                                        sellerName = currentUser!!.fullName,
                                        batchTag = currentUser!!.batchTag,
                                        fileUrl = fileUri?.toString() ?: ""
                                    )
                                    listings = listOf(newItem) + listings
                                    isPosting = false
                                    selectedTab = 0
                                }
                            }
                        )
                        2 -> ProfileScreen(
                            user = currentUser!!,
                            listings = listings,
                            savedIds = savedIds,
                            downloadedIds = downloadedIds,
                            onMarkSold = { id ->
                                listings = listings.map { if (it.id == id) it.copy(isSold = true) else it }
                            },
                            onDeleteListing = { id ->
                                listings = listings.filterNot { it.id == id }
                            },
                            onSignOut = {
                                currentUser = null
                                listings = emptyList()
                                savedIds = emptySet()
                                downloadedIds = emptySet()
                                selectedTab = 0
                            }
                        )
                    }
                }
                AnimatedFloatingBottomBar(
                    selectedTab = selectedTab,
                    onTabSelected = { selectedTab = it },
                    modifier = Modifier
                        .align(Alignment.BottomCenter)
                        .padding(horizontal = 18.dp, vertical = 14.dp)
                )
            }
        }
    }
}

