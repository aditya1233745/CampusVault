@Composable
fun OnboardingAuthScreen(
    initialMode: AuthMode = AuthMode.WELCOME,
    isLoading: Boolean = false,
    message: String? = null,
    onModeChange: () -> Unit = {},
    onLogin: (String, String) -> Unit = { _, _ -> },
    onSignUp: (String, String, String, String, String) -> Unit = { _, _, _, _, _ -> }
) {
    var authMode by remember { mutableStateOf(initialMode) }
    AnimatedContent(
        targetState = authMode,
        transitionSpec = { fadeIn(tween(260)) togetherWith fadeOut(tween(180)) },
        label = "authTransition"
    ) { mode ->
        when (mode) {
            AuthMode.WELCOME -> WelcomeHeroScreen(
                onGetStarted = { authMode = AuthMode.LOGIN }
            )
            AuthMode.LOGIN -> LoginSheetScreen(
                isLoading = isLoading,
                message = message,
                onSwitchToSignUp = { onModeChange(); authMode = AuthMode.SIGNUP },
                onLogin = onLogin
            )
            AuthMode.SIGNUP -> SignUpSheetScreen(
                isLoading = isLoading,
                message = message,
                onSwitchToLogin = { onModeChange(); authMode = AuthMode.LOGIN },
                onSignUp = onSignUp
            )
        }
    }
}

